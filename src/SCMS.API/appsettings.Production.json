{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "#{SCMS_DB_CONNECTION_STRING}#"
  },
  "Attachments": {
    "StoragePath": "#{SCMS_UPLOAD_PATH}#",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx" ]
  },
  "Jwt": {
    "Key": "#{SCMS_JWT_KEY}#",
    "Issuer": "SCMS.API",
    "Audience": "SCMS.Client",
    "ExpiryMinutes": 60
  },
  "Seed": {
    "SeedOnStartup": false,
    "AdminEmail": "#{SCMS_ADMIN_EMAIL}#",
    "AdminPassword": "#{SCMS_ADMIN_PASSWORD}#",
    "AdminUserName": "#{SCMS_ADMIN_USERNAME}#",
    "AdminFullName": "#{SCMS_ADMIN_FULLNAME}#"
  }
}
