{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Attachments": {
    "StoragePath": "uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx" ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SCMS.API",
    "Audience": "SCMS.Client",
    "ExpiryMinutes": 120
  },
  "Seed": {
    "SeedOnStartup": false
  }
}
