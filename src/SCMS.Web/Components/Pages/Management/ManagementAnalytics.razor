@page "/management/analytics"
@attribute [Authorize(Roles = "Admin,Management")]
@using System.Globalization
@inject IAnalyticsService Analytics
@inject IJSRuntime JS
@inject ILogger<ManagementAnalytics> Logger

<PageTitle>Management Analytics - SCMS Portal</PageTitle>

<div class="mx-auto w-full max-w-[1140px]">

    @* Page header *@
    <div class="mb-xl flex flex-col justify-between gap-md sm:flex-row sm:items-end">
        <div>
            <h1 tabindex="-1" class="mb-2 text-headline-lg-mobile text-on-surface focus:outline-none md:text-headline-lg">Management Analytics</h1>
            <p class="text-body-md text-on-surface-variant">All-time complaint volumes and resolution performance.</p>
        </div>
        <span class="rounded-lg bg-surface-container px-md py-sm text-label-sm text-on-surface-variant">All time</span>
    </div>

    @if (_loadFailed)
    {
        <div class="mb-xl flex flex-col items-start gap-md rounded-xl bg-error-container p-lg text-on-error-container sm:flex-row sm:items-center sm:justify-between" role="alert">
            <div class="flex items-start gap-3">
                <Icon Name="error" />
                <div>
                    <p class="text-title-md">We couldn't load the analytics</p>
                    <p class="text-body-md">Check your connection and try again.</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary shrink-0" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (_data is null)
    {
        <div role="status" aria-label="Loading analytics" class="flex flex-col gap-lg">
            <div class="grid grid-cols-1 gap-lg md:grid-cols-12">
                <div class="h-96 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-8"></div>
                <div class="h-96 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-4"></div>
            </div>
            <div class="grid grid-cols-1 gap-lg md:grid-cols-12">
                <div class="h-80 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-8"></div>
                <div class="h-80 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-4"></div>
            </div>
        </div>
    }
    else
    {
        <div class="@(_loading ? "opacity-60 transition-opacity" : "transition-opacity")" aria-busy="@(_loading ? "true" : "false")">

            @* Charts row *@
            <div class="mb-xl grid grid-cols-1 gap-lg md:grid-cols-12">
                <section class="flex flex-col rounded-xl border border-outline-variant bg-surface-container-lowest p-lg shadow-sm md:col-span-8">
                    <div class="mb-md flex items-center justify-between">
                        <h2 class="text-title-md text-on-surface">Complaints by Status</h2>
                    </div>
                    <div class="mt-auto pt-md">
                        <BarChart Items="_data.ByStatus" Title="Complaints by status" />
                    </div>
                </section>

                <section class="flex flex-col rounded-xl border border-outline-variant bg-surface-container-lowest p-lg shadow-sm md:col-span-4">
                    <div class="mb-md">
                        <h2 class="text-title-md text-on-surface">Resolution Rate</h2>
                        <div class="mt-2 flex items-baseline gap-2">
                            <span class="text-display-lg text-primary">@_data.ResolutionRate.ToString("0")%</span>
                        </div>
                        <p class="mt-1 text-caption text-on-surface-variant">@_data.Resolved of @_data.Total complaints resolved</p>
                    </div>
                    <div class="mt-auto grid grid-cols-2 gap-md border-t border-surface-variant pt-md">
                        <div>
                            <p class="text-caption text-on-surface-variant">Average time</p>
                            <p class="text-title-md text-on-surface">@_data.AverageResolutionHours.ToString("0.0") hrs</p>
                        </div>
                        <div>
                            <p class="text-caption text-on-surface-variant">Median time</p>
                            <p class="text-title-md text-on-surface">@_data.MedianResolutionHours.ToString("0.0") hrs</p>
                        </div>
                    </div>
                </section>
            </div>

            @* Leaderboard + export row *@
            <div class="grid grid-cols-1 gap-lg md:grid-cols-12">
                <section class="flex flex-col overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest shadow-sm md:col-span-8">
                    <div class="flex items-center justify-between border-b border-outline-variant bg-surface-bright p-lg">
                        <h2 class="text-title-md text-on-surface">Department Efficiency</h2>
                        <span class="text-caption text-on-surface-variant">Complaint volume</span>
                    </div>
                    <div class="flex-1 overflow-auto">
                        <table class="w-full border-collapse text-left">
                            <caption class="sr-only">Departments ranked by average resolution time</caption>
                            <thead>
                                <tr class="bg-surface-container-low text-label-sm text-on-surface-variant">
                                    <th scope="col" class="w-12 p-4 text-center font-medium">#</th>
                                    <th scope="col" class="p-4 font-medium">Department</th>
                                    <th scope="col" class="p-4 font-medium">Complaints</th>
                                </tr>
                            </thead>
                            <tbody class="text-body-md">
                                @for (var i = 0; i < _data.ByDepartment.Count; i++)
                                {
                                    var department = _data.ByDepartment[i];
                                    <tr @key="department.Label" class="border-b border-surface-variant transition-colors last:border-b-0 hover:bg-surface">
                                        <td class="@(i == 0 ? "p-4 text-center font-semibold text-primary" : "p-4 text-center text-on-surface-variant")">@(i + 1)</td>
                                        <td class="p-4">@department.Label</td>
                                        <td class="p-4 whitespace-nowrap">@department.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="relative flex flex-col justify-between overflow-hidden rounded-xl bg-primary p-lg text-on-primary shadow-md md:col-span-4">
                    <div class="pointer-events-none absolute -top-10 -right-10 opacity-10" aria-hidden="true">
                        <Icon Name="summarize" Class="text-[150px]" />
                    </div>

                    <div class="relative z-10">
                        <h2 class="mb-2 text-title-md">Export all-time report</h2>
                        <p class="mb-lg text-body-md text-primary-fixed-dim">Download the current API summary as a CSV file.</p>
                    </div>

                    <div class="relative z-10 mt-xl">
                        @if (_exportError is not null)
                        {
                            <p class="mb-sm rounded-lg bg-error-container px-md py-sm text-caption text-on-error-container" role="alert">@_exportError</p>
                        }
                        else if (_exportDone)
                        {
                            <p class="mb-sm text-caption text-primary-fixed" role="status">Report downloaded.</p>
                        }

                        <button type="button"
                                class="flex w-full items-center justify-center gap-2 rounded-lg bg-on-primary py-3 text-label-sm text-primary transition-colors hover:bg-primary-fixed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-primary disabled:cursor-not-allowed disabled:opacity-60"
                                disabled="@_exporting"
                                @onclick="ExportAsync">
                            @if (_exporting)
                            {
                                <Icon Name="progress_activity" Class="animate-spin motion-reduce:animate-none" />
                                <span>Generating...</span>
                            }
                            else
                            {
                                <Icon Name="download" />
                                <span>Download CSV</span>
                            }
                        </button>
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    private ManagementAnalyticsData? _data;
    private bool _loading;
    private bool _loadFailed;

    private bool _exporting;
    private bool _exportDone;
    private string? _exportError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadFailed = false;
        _loading = true;

        try
        {
            _data = await Analytics.GetAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load management analytics");
            _data = null;
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_exporting)
        {
            return;
        }

        _exporting = true;
        _exportDone = false;
        _exportError = null;

        try
        {
            var report = await Analytics.ExportAsync();

            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await module.InvokeVoidAsync("downloadFile", report.FileName, report.ContentType, report.Content);

            _exportDone = true;
        }
        catch (NotSupportedException ex)
        {
            _exportError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report export failed");
            _exportError = "We couldn't generate the report. Try again in a moment.";
        }
        finally
        {
            _exporting = false;
        }
    }

}
