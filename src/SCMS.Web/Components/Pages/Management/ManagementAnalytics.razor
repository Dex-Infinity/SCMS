@page "/management/analytics"
@using System.Globalization
@inject IAnalyticsService Analytics
@inject IJSRuntime JS
@inject ILogger<ManagementAnalytics> Logger

<PageTitle>Management Analytics - SCMS Portal</PageTitle>

<div class="mx-auto w-full max-w-[1140px]">

    @* Page header *@
    <div class="mb-xl flex flex-col justify-between gap-md sm:flex-row sm:items-end">
        <div>
            <h1 tabindex="-1" class="mb-2 text-headline-lg-mobile text-on-surface focus:outline-none md:text-headline-lg">Management Analytics</h1>
            <p class="text-body-md text-on-surface-variant">Overview of institutional complaint resolution and department performance.</p>
        </div>

        <div class="relative sm:shrink-0">
            <Icon Name="calendar_today" Class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-[18px] text-on-surface" />
            <select aria-label="Report period"
                    class="w-full appearance-none rounded-lg border border-outline-variant bg-surface-container py-sm pr-9 pl-9 sm:w-auto text-label-sm text-on-surface transition-colors hover:bg-surface-container-high focus-visible:outline-2 focus-visible:outline-primary-container"
                    @bind="_range"
                    @bind:after="LoadAsync">
                @foreach (var range in Enum.GetValues<ReportRange>())
                {
                    <option value="@range">@ReportRanges.LabelFor(range)</option>
                }
            </select>
            <Icon Name="expand_more" Class="pointer-events-none absolute top-1/2 right-2 -translate-y-1/2 text-[18px] text-on-surface-variant" />
        </div>
    </div>

    @if (_loadFailed)
    {
        <div class="mb-xl flex flex-col items-start gap-md rounded-xl bg-error-container p-lg text-on-error-container sm:flex-row sm:items-center sm:justify-between" role="alert">
            <div class="flex items-start gap-3">
                <Icon Name="error" />
                <div>
                    <p class="text-title-md">We couldn't load the analytics</p>
                    <p class="text-body-md">Check your connection and try again.</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary shrink-0" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (_data is null)
    {
        <div role="status" aria-label="Loading analytics" class="flex flex-col gap-lg">
            <div class="grid grid-cols-1 gap-lg md:grid-cols-12">
                <div class="h-96 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-8"></div>
                <div class="h-96 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-4"></div>
            </div>
            <div class="grid grid-cols-1 gap-lg md:grid-cols-12">
                <div class="h-80 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-8"></div>
                <div class="h-80 animate-pulse rounded-xl bg-surface-container motion-reduce:animate-none md:col-span-4"></div>
            </div>
        </div>
    }
    else
    {
        <div class="@(_loading ? "opacity-60 transition-opacity" : "transition-opacity")" aria-busy="@(_loading ? "true" : "false")">

            @* Charts row *@
            <div class="mb-xl grid grid-cols-1 gap-lg md:grid-cols-12">
                <section class="flex flex-col rounded-xl border border-outline-variant bg-surface-container-lowest p-lg shadow-sm md:col-span-8">
                    <div class="mb-md flex items-center justify-between">
                        <h2 class="text-title-md text-on-surface">Complaints by Category</h2>
                        <button type="button" class="rounded-full text-secondary transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-primary-container" aria-label="Chart options">
                            <Icon Name="more_vert" />
                        </button>
                    </div>
                    <div class="mt-auto pt-md">
                        <BarChart Items="_data.ComplaintsByCategory" Title="Complaints by category" />
                    </div>
                </section>

                <section class="flex flex-col rounded-xl border border-outline-variant bg-surface-container-lowest p-lg shadow-sm md:col-span-4">
                    <div class="mb-md">
                        <h2 class="text-title-md text-on-surface">Resolution Rate</h2>
                        <div class="mt-2 flex items-baseline gap-2">
                            <span class="text-display-lg text-primary">@FormatRate(_data.ResolutionRate)%</span>
                            <span class="flex items-center text-label-sm text-tertiary-container">
                                <Icon Name="@(_data.ResolutionRateChange >= 0 ? "trending_up" : "trending_down")" Class="text-[16px]" />
                                @TrendText
                            </span>
                        </div>
                    </div>
                    <div class="mt-auto min-h-[190px] flex-1">
                        <AreaChart Points="_data.ResolutionTrend" Title="Resolution rate by month" />
                    </div>
                </section>
            </div>

            @* Leaderboard + export row *@
            <div class="grid grid-cols-1 gap-lg md:grid-cols-12">
                <section class="flex flex-col overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest shadow-sm md:col-span-8">
                    <div class="flex items-center justify-between border-b border-outline-variant bg-surface-bright p-lg">
                        <h2 class="text-title-md text-on-surface">Department Efficiency</h2>
                        <span class="text-caption text-on-surface-variant">Avg. Resolution Time</span>
                    </div>
                    <div class="flex-1 overflow-auto">
                        <table class="w-full border-collapse text-left">
                            <caption class="sr-only">Departments ranked by average resolution time</caption>
                            <thead>
                                <tr class="bg-surface-container-low text-label-sm text-on-surface-variant">
                                    <th scope="col" class="w-12 p-4 text-center font-medium">#</th>
                                    <th scope="col" class="p-4 font-medium">Department</th>
                                    <th scope="col" class="p-4 font-medium">Avg Time</th>
                                    <th scope="col" class="p-4 font-medium">Status</th>
                                </tr>
                            </thead>
                            <tbody class="text-body-md">
                                @for (var i = 0; i < _data.Departments.Count; i++)
                                {
                                    var department = _data.Departments[i];
                                    <tr @key="department.Name" class="border-b border-surface-variant transition-colors last:border-b-0 hover:bg-surface">
                                        <td class="@(i == 0 ? "p-4 text-center font-semibold text-primary" : "p-4 text-center text-on-surface-variant")">@(i + 1)</td>
                                        <td class="p-4">@department.Name</td>
                                        <td class="p-4 whitespace-nowrap">@FormatDays(department.AverageDays)</td>
                                        <td class="p-4">
                                            <span class="inline-flex items-center gap-1 rounded px-2 py-1 text-caption whitespace-nowrap @RatingClasses(department.Rating)">@RatingLabel(department.Rating)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="relative flex flex-col justify-between overflow-hidden rounded-xl bg-primary p-lg text-on-primary shadow-md md:col-span-4">
                    <div class="pointer-events-none absolute -top-10 -right-10 opacity-10" aria-hidden="true">
                        <Icon Name="summarize" Class="text-[150px]" />
                    </div>

                    <div class="relative z-10">
                        <h2 class="mb-2 text-title-md">Export Report</h2>
                        <p class="mb-lg text-body-md text-primary-fixed-dim">Generate a detailed summary of all institutional complaints and resolutions.</p>

                        <div class="flex flex-col gap-md">
                            <div>
                                <label for="export-range" class="mb-1 block text-label-sm text-primary-fixed">Date Range</label>
                                <div class="relative">
                                    <select id="export-range"
                                            class="w-full appearance-none rounded-lg border-none bg-surface-tint px-3 py-2 pr-10 text-body-md text-on-primary focus:ring-2 focus:ring-primary-fixed focus:outline-none [&>option]:bg-surface-container-lowest [&>option]:text-on-surface"
                                            @bind="_exportRange">
                                        @foreach (var range in Enum.GetValues<ReportRange>())
                                        {
                                            <option value="@range">@ReportRanges.LabelFor(range)</option>
                                        }
                                    </select>
                                    <Icon Name="expand_more" Class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-primary-fixed-dim" />
                                </div>
                            </div>

                            <fieldset>
                                <legend class="mb-1 block text-label-sm text-primary-fixed">Format</legend>
                                <div class="flex gap-sm">
                                    <label class="flex-1 cursor-pointer">
                                        <input type="radio" name="export-format" class="peer sr-only"
                                               checked="@(_format == ReportFormat.Pdf)"
                                               @onchange="() => _format = ReportFormat.Pdf" />
                                        <div class="rounded-lg border border-primary-fixed-dim py-2 text-center text-label-sm transition-colors peer-checked:bg-primary-fixed peer-checked:text-on-primary-fixed peer-focus-visible:ring-2 peer-focus-visible:ring-primary-fixed peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-primary">PDF</div>
                                    </label>
                                    <label class="flex-1 cursor-pointer">
                                        <input type="radio" name="export-format" class="peer sr-only"
                                               checked="@(_format == ReportFormat.Csv)"
                                               @onchange="() => _format = ReportFormat.Csv" />
                                        <div class="rounded-lg border border-primary-fixed-dim py-2 text-center text-label-sm transition-colors peer-checked:bg-primary-fixed peer-checked:text-on-primary-fixed peer-focus-visible:ring-2 peer-focus-visible:ring-primary-fixed peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-primary">CSV</div>
                                    </label>
                                </div>
                            </fieldset>
                        </div>
                    </div>

                    <div class="relative z-10 mt-xl">
                        @if (_exportError is not null)
                        {
                            <p class="mb-sm rounded-lg bg-error-container px-md py-sm text-caption text-on-error-container" role="alert">@_exportError</p>
                        }
                        else if (_exportDone)
                        {
                            <p class="mb-sm text-caption text-primary-fixed" role="status">Report downloaded.</p>
                        }

                        <button type="button"
                                class="flex w-full items-center justify-center gap-2 rounded-lg bg-on-primary py-3 text-label-sm text-primary transition-colors hover:bg-primary-fixed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-primary disabled:cursor-not-allowed disabled:opacity-60"
                                disabled="@_exporting"
                                @onclick="ExportAsync">
                            @if (_exporting)
                            {
                                <Icon Name="progress_activity" Class="animate-spin motion-reduce:animate-none" />
                                <span>Generating...</span>
                            }
                            else
                            {
                                <Icon Name="download" />
                                <span>Generate Report</span>
                            }
                        </button>
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    private ManagementAnalyticsData? _data;
    private ReportRange _range = ReportRange.Last30Days;
    private bool _loading;
    private bool _loadFailed;

    private ReportRange _exportRange = ReportRange.Last30Days;
    private ReportFormat _format = ReportFormat.Pdf;
    private bool _exporting;
    private bool _exportDone;
    private string? _exportError;

    private string TrendText =>
        _data is null
            ? string.Empty
            : (_data.ResolutionRateChange >= 0 ? "+" : string.Empty)
              + _data.ResolutionRateChange.ToString("0.0", CultureInfo.InvariantCulture) + "%";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadFailed = false;
        _loading = true;

        try
        {
            _data = await Analytics.GetAsync(_range);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load management analytics");
            _data = null;
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_exporting)
        {
            return;
        }

        _exporting = true;
        _exportDone = false;
        _exportError = null;

        try
        {
            var report = await Analytics.ExportAsync(_exportRange, _format);

            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await module.InvokeVoidAsync("downloadFile", report.FileName, report.ContentType, report.Content);

            _exportDone = true;
        }
        catch (NotSupportedException ex)
        {
            _exportError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report export failed");
            _exportError = "We couldn't generate the report. Try again in a moment.";
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string FormatRate(double rate) => rate.ToString("0", CultureInfo.InvariantCulture);

    private static string FormatDays(double days) => days.ToString("0.0", CultureInfo.InvariantCulture) + " Days";

    private static string RatingLabel(DepartmentRating rating) => rating switch
    {
        DepartmentRating.Excellent => "Excellent",
        DepartmentRating.Average => "Average",
        DepartmentRating.NeedsAttention => "Needs Attention",
        _ => rating.ToString()
    };

    // Keep these class names literal so Tailwind can find them.
    private static string RatingClasses(DepartmentRating rating) => rating switch
    {
        DepartmentRating.Excellent => "bg-secondary-fixed text-on-secondary-fixed",
        DepartmentRating.Average => "bg-surface-container-high text-on-surface",
        DepartmentRating.NeedsAttention => "bg-error-container text-on-error-container",
        _ => "bg-surface-variant text-on-surface-variant"
    };
}
