@page "/login"
@layout Layout.LoginLayout

<PageTitle>Sign in - SCMS Portal</PageTitle>

<main class="flex min-h-screen items-center justify-center bg-surface px-md py-xl">
    <section class="w-full max-w-[26rem] rounded-xl border border-surface-variant bg-surface-container-lowest p-xl shadow-sm">
        <a href="/" class="mb-xl inline-flex items-center gap-3 text-title-md text-primary">
            <img src="/images/crest.svg" alt="" class="size-10" />
            SCMS Portal
        </a>
        <h1 tabindex="-1" class="text-headline-lg-mobile text-on-surface focus:outline-none">Sign in</h1>
        <p class="mt-2 text-body-md text-on-surface-variant">Use your SCMS account to continue.</p>

        @if (Error)
        {
            <p class="mt-lg rounded-lg bg-error-container px-md py-sm text-body-md text-on-error-container" role="alert">
                @(ErrorQuery == "session"
                    ? "Your session expired or the API rejected it. Please sign in again."
                    : ErrorQuery == "signup"
                        ? "We couldn't create your account. Check the details, password requirements, and whether the email is already registered."
                        : "Sign-in failed. Check your credentials and try again.")
            </p>
        }

        <form action="/auth/login" method="post" class="mt-xl flex flex-col gap-lg">
            <div class="flex flex-col gap-2">
                <label class="field-label" for="email">Email</label>
                <input class="field-input" id="email" name="Email" type="email" autocomplete="username" required />
            </div>
            <div class="flex flex-col gap-2">
                <label class="field-label" for="password">Password</label>
                <input class="field-input" id="password" name="Password" type="password" autocomplete="current-password" required />
            </div>
            <button class="btn btn-primary mt-sm w-full" type="submit">Sign in</button>
        </form>
        <p class="mt-lg text-center text-body-md text-on-surface-variant">
            Don't have an account? <a href="/signup" class="font-semibold text-primary hover:underline">Create account</a>
        </p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorQuery { get; set; }

    private bool Error => ErrorQuery is "1" or "session";
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Sign in - SCMS Portal</PageTitle>

<div class="mx-auto flex min-h-[70vh] w-full max-w-md items-center">
    <section class="w-full rounded-xl border border-outline-variant bg-surface-container-lowest p-xl shadow-sm">
        <div class="mb-xl">
            <p class="text-label-sm font-semibold text-primary">SCMS PORTAL</p>
            <h1 class="mt-2 text-headline-lg-mobile text-on-surface md:text-headline-lg">Sign in</h1>
            <p class="mt-2 text-body-md text-on-surface-variant">Use your student or administrator account.</p>
        </div>

        @if (Error is not null)
        {
            <p class="mb-lg rounded-lg bg-error-container p-md text-body-md text-on-error-container" role="alert">We couldn't sign you in. Check your details and try again.</p>
        }

        <form method="post" action="/account/login" class="flex flex-col gap-lg">
            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
            <div class="flex flex-col gap-2">
                <label class="field-label" for="login-email">Email</label>
                <input class="field-input" id="login-email" name="email" type="email" autocomplete="username" required />
            </div>
            <div class="flex flex-col gap-2">
                <label class="field-label" for="login-password">Password</label>
                <input class="field-input" id="login-password" name="password" type="password" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn btn-primary w-full">Sign in</button>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string SafeReturnUrl => !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
        ? ReturnUrl
        : string.Empty;
}