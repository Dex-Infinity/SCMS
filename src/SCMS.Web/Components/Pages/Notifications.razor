@page "/notifications"
@attribute [Authorize]
@inject ScmsApiClient Api
@inject ILogger<Notifications> Logger

<PageTitle>Notifications - SCMS Portal</PageTitle>

<div class="mx-auto flex w-full max-w-[900px] flex-col gap-xl">
    <header class="flex flex-col justify-between gap-md sm:flex-row sm:items-end">
        <div><h1 tabindex="-1" class="text-headline-lg-mobile text-on-surface focus:outline-none md:text-headline-lg">Notifications</h1><p class="mt-2 text-body-md text-on-surface-variant">Updates about complaint assignments and status changes.</p></div>
        <div class="flex flex-wrap items-center gap-md">
            <label class="inline-flex items-center gap-2 text-label-sm text-on-surface-variant">
                <input type="checkbox" checked="@_unreadOnly" @onchange="ChangeUnreadFilterAsync" />
                Unread only
            </label>
            @if (_notifications?.Any(item => !item.IsRead) == true)
            {
                <button type="button" class="btn btn-secondary shrink-0" disabled="@_busy" @onclick="MarkAllReadAsync"><Icon Name="done_all" />Mark all as read</button>
            }
        </div>
    </header>

    <AuthorizeView Roles="Admin">
        <Authorized Context="adminView">
            <section class="flex flex-col gap-lg border-y border-surface-variant py-lg" aria-labelledby="notification-admin-heading">
                <div>
                    <h2 id="notification-admin-heading" class="text-title-md text-on-surface">Notification administration</h2>
                    <p class="mt-1 text-body-sm text-on-surface-variant">Manage notifications for an account using its Identity user ID or student ID.</p>
                </div>
                @if (_adminError is not null) { <p class="text-body-sm text-error" role="alert">@_adminError</p> }
                @if (_adminNotice is not null) { <p class="text-body-sm text-primary" role="status">@_adminNotice</p> }
                <div class="grid grid-cols-1 gap-md sm:grid-cols-[minmax(0,1fr)_auto]">
                    <div class="flex flex-col gap-2">
                        <label class="field-label" for="notification-user-id">Target user ID</label>
                        <input id="notification-user-id" class="field-input" @bind="_lookupUserId" autocomplete="off" />
                    </div>
                    <button type="button" class="btn btn-secondary self-end" disabled="@_busy" @onclick="LoadUserNotificationsAsync">Load user's notifications</button>
                </div>
                <EditForm Model="_adminDraft" OnValidSubmit="CreateNotificationAsync" class="grid grid-cols-1 gap-md md:grid-cols-2">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-caption text-error md:col-span-2" />
                    <div class="flex flex-col gap-2">
                        <label class="field-label" for="new-notification-user">Target user ID</label>
                        <InputText id="new-notification-user" class="field-input" @bind-Value="_adminDraft.UserId" autocomplete="off" />
                        <ValidationMessage For="() => _adminDraft.UserId" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="field-label" for="new-notification-title">Title</label>
                        <InputText id="new-notification-title" class="field-input" @bind-Value="_adminDraft.Title" maxlength="200" />
                        <ValidationMessage For="() => _adminDraft.Title" />
                    </div>
                    <div class="flex flex-col gap-2 md:col-span-2">
                        <label class="field-label" for="new-notification-message">Message</label>
                        <InputTextArea id="new-notification-message" class="field-input resize-y" rows="3" @bind-Value="_adminDraft.Message" />
                        <ValidationMessage For="() => _adminDraft.Message" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="field-label" for="new-notification-complaint">Complaint ID <span class="text-outline">(optional)</span></label>
                        <InputNumber id="new-notification-complaint" class="field-input" @bind-Value="_adminDraft.ComplaintId" min="1" />
                    </div>
                    <button type="submit" class="btn btn-primary self-end" disabled="@_busy">Create notification</button>
                </EditForm>
                @if (_targetNotifications is not null)
                {
                    <div class="divide-y divide-surface-variant border-y border-surface-variant">
                        @if (_targetNotifications.Count == 0)
                        {
                            <p class="py-md text-body-sm text-on-surface-variant">No notifications for this account.</p>
                        }
                        @foreach (var notification in _targetNotifications.OrderByDescending(item => item.CreatedAt))
                        {
                            <div @key="notification.Id" class="flex flex-wrap items-center gap-md py-sm">
                                <span class="min-w-0 flex-1 text-body-sm text-on-surface">@notification.Title · #@notification.Id</span>
                                <button type="button" class="text-label-sm text-primary hover:underline" @onclick="() => LoadDetailsAsync(notification.Id)">Details</button>
                                <button type="button" class="icon-btn text-error" title="Delete notification" aria-label="Delete notification @notification.Id" disabled="@_busy" @onclick="() => DeleteNotificationAsync(notification)"><Icon Name="delete" /></button>
                            </div>
                        }
                    </div>
                }
            </section>
        </Authorized>
    </AuthorizeView>

    @if (_selectedNotification is not null)
    {
        <section class="flex flex-col gap-2 border-b border-surface-variant pb-lg" aria-labelledby="notification-detail-heading">
            <div class="flex items-center justify-between gap-md">
                <h2 id="notification-detail-heading" class="text-title-md text-on-surface">Notification details</h2>
                <button type="button" class="icon-btn" title="Close details" aria-label="Close notification details" @onclick="() => _selectedNotification = null"><Icon Name="close" /></button>
            </div>
            <p class="text-label-md font-semibold text-on-surface">@_selectedNotification.Title</p>
            <p class="whitespace-pre-wrap text-body-md text-on-surface-variant">@_selectedNotification.Message</p>
            @if (_selectedNotification.ComplaintId.HasValue)
            {
                <a href="@AppRoutes.ComplaintDetails(_selectedNotification.ComplaintId.Value)" class="text-label-sm text-primary hover:underline">View complaint #@_selectedNotification.ComplaintId</a>
            }
        </section>
    }

    @if (_error is not null)
    {
        <div class="flex flex-col items-start gap-md rounded-xl bg-error-container p-lg text-on-error-container sm:flex-row sm:items-center sm:justify-between" role="alert">
            <div><h2 class="text-title-md">Notifications couldn't be loaded</h2><p class="text-body-md">@_error</p></div>
            <button type="button" class="btn btn-primary shrink-0" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (_notifications is null)
    {
        <div role="status" aria-label="Loading notifications" class="flex flex-col gap-md">
            <div class="h-28 animate-pulse rounded-xl bg-surface-container"></div><div class="h-28 animate-pulse rounded-xl bg-surface-container"></div><div class="h-28 animate-pulse rounded-xl bg-surface-container"></div>
        </div>
    }
    else if (_notifications.Count == 0)
    {
        <section class="flex flex-col items-center gap-md rounded-xl border border-surface-variant bg-surface-container-lowest p-xl text-center" role="status">
            <span class="flex size-12 items-center justify-center rounded-full bg-primary-fixed text-primary"><Icon Name="notifications_none" /></span>
            <h2 class="text-title-md text-on-surface">You're all caught up</h2>
            <p class="text-body-md text-on-surface-variant">Complaint updates will appear here.</p>
        </section>
    }
    else
    {
        @if (_notice is not null) { <p class="rounded-lg bg-primary-fixed px-md py-sm text-body-md text-on-primary-fixed" role="status">@_notice</p> }
        <ol class="divide-y divide-outline-variant/50 border-y border-outline-variant/50" aria-label="Your notifications">
            @foreach (var notification in _notifications.OrderByDescending(item => item.CreatedAt))
            {
                <li @key="notification.Id" class="flex items-start gap-md py-lg @(notification.IsRead ? "" : "bg-primary-fixed/20")">
                    <span class="mt-1 flex size-10 shrink-0 items-center justify-center rounded-full @(notification.IsRead ? "bg-surface-container text-on-surface-variant" : "bg-primary-fixed text-primary")" aria-hidden="true">
                        <Icon Name="@(notification.IsRead ? "notifications" : "mark_email_unread")" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-md gap-y-1">
                            <h2 class="text-label-md font-semibold text-on-surface">@notification.Title</h2>
                            <time class="text-caption text-on-surface-variant" datetime="@notification.CreatedAt.ToString("O")">@notification.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</time>
                        </div>
                        <p class="mt-1 whitespace-pre-wrap text-body-md text-on-surface-variant">@notification.Message</p>
                        <div class="mt-sm flex flex-wrap items-center gap-md">
                            @if (notification.ComplaintId.HasValue)
                            {
                                <a href="@AppRoutes.ComplaintDetails(notification.ComplaintId.Value)" class="text-label-sm text-primary hover:underline">View complaint #@notification.ComplaintId</a>
                            }
                            <button type="button" class="text-label-sm text-primary hover:underline" @onclick="() => LoadDetailsAsync(notification.Id)">Details</button>
                            @if (!notification.IsRead)
                            {
                                <button type="button" class="text-label-sm text-primary hover:underline disabled:opacity-50" disabled="@_busy" @onclick="() => MarkReadAsync(notification)">Mark as read</button>
                            }
                        </div>
                    </div>
                </li>
            }
        </ol>
    }
</div>

@code {
    private List<ApiNotification>? _notifications;
    private List<ApiNotification>? _targetNotifications;
    private ApiNotificationCreateForm _adminDraft = new();
    private ApiNotification? _selectedNotification;
    private string _lookupUserId = string.Empty;
    private string? _adminError;
    private string? _adminNotice;
    private bool _unreadOnly;
    private string? _error;
    private string? _notice;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try { _notifications = (await Api.GetNotificationsAsync(_unreadOnly)).ToList(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load notifications");
            _error = ex is UnauthorizedAccessException ? ex.Message : "Check the API connection and try again.";
        }
    }

    private async Task ChangeUnreadFilterAsync(ChangeEventArgs args)
    {
        _unreadOnly = args.Value is bool isChecked && isChecked;
        await LoadAsync();
    }

    private async Task MarkReadAsync(ApiNotification notification)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.MarkNotificationReadAsync(notification.Id);
            notification.IsRead = true;
            _notice = "Notification marked as read.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to mark notification {NotificationId} as read", notification.Id);
            _error = "This notification could not be updated. Try again.";
        }
        finally { _busy = false; }
    }

    private async Task MarkAllReadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.MarkAllNotificationsReadAsync();
            foreach (var notification in _notifications!) notification.IsRead = true;
            _notice = "All notifications marked as read.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to mark all notifications as read");
            _error = "Notifications could not be updated. Try again.";
        }
        finally { _busy = false; }
    }

    private async Task LoadDetailsAsync(int id)
    {
        _adminError = null;
        try
        {
            _selectedNotification = await Api.GetNotificationAsync(id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load notification {NotificationId}", id);
            _adminError = "Notification details could not be loaded.";
        }
    }

    private async Task LoadUserNotificationsAsync()
    {
        if (string.IsNullOrWhiteSpace(_lookupUserId))
        {
            _adminError = "Enter a target user ID.";
            return;
        }

        _adminError = null;
        _adminNotice = null;
        _busy = true;
        try
        {
            _targetNotifications = (await Api.GetNotificationsForUserAsync(_lookupUserId.Trim())).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load notifications for target user");
            _adminError = "Notifications for that account could not be loaded.";
        }
        finally { _busy = false; }
    }

    private async Task CreateNotificationAsync()
    {
        _adminError = null;
        _adminNotice = null;
        _busy = true;
        try
        {
            var targetUserId = _adminDraft.UserId.Trim();
            await Api.CreateNotificationAsync(new ApiNotificationCreate
            {
                UserId = targetUserId,
                Title = _adminDraft.Title.Trim(),
                Message = _adminDraft.Message.Trim(),
                ComplaintId = _adminDraft.ComplaintId
            });
            _adminNotice = "Notification created.";
            if (_targetNotifications is not null && string.Equals(_lookupUserId.Trim(), targetUserId, StringComparison.OrdinalIgnoreCase))
            {
                await LoadUserNotificationsAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create notification");
            _adminError = "The notification could not be created.";
        }
        finally { _busy = false; }
    }

    private async Task DeleteNotificationAsync(ApiNotification notification)
    {
        _adminError = null;
        _adminNotice = null;
        _busy = true;
        try
        {
            await Api.DeleteNotificationAsync(notification.Id);
            _notifications?.RemoveAll(item => item.Id == notification.Id);
            _targetNotifications?.RemoveAll(item => item.Id == notification.Id);
            if (_selectedNotification?.Id == notification.Id) _selectedNotification = null;
            _adminNotice = "Notification deleted.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete notification {NotificationId}", notification.Id);
            _adminError = "The notification could not be deleted.";
        }
        finally { _busy = false; }
    }

    private sealed class ApiNotificationCreateForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string UserId { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(200, MinimumLength = 2)]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Message { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue)]
        public int? ComplaintId { get; set; }
    }
}