@page "/signup"
@layout Layout.LoginLayout

<PageTitle>Registration unavailable - SCMS Portal</PageTitle>

<main class="flex min-h-screen items-center justify-center bg-surface px-md py-xl">
    <section class="w-full max-w-[30rem] rounded-xl border border-surface-variant bg-surface-container-lowest p-xl shadow-sm" role="status">
        <a href="/login" class="mb-xl inline-flex items-center gap-3 text-title-md text-primary">
            <img src="/images/crest.svg" alt="" class="size-10" />
            SCMS Portal
        </a>
        <h1 tabindex="-1" class="text-headline-lg-mobile text-on-surface focus:outline-none">Registration unavailable</h1>
        <p class="mt-2 text-body-md text-on-surface-variant">New account registration is temporarily unavailable. Sign in with an existing account.</p>
        <p class="mt-lg text-center text-body-md text-on-surface-variant">
            <a href="/login" class="font-semibold text-primary hover:underline">Sign in</a>
        </p>
    </section>
</main>
