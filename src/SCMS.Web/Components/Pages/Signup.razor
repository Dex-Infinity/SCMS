@page "/signup"
@layout Layout.LoginLayout

<PageTitle>Create account - SCMS Portal</PageTitle>

<main class="flex min-h-screen items-center justify-center bg-surface px-md py-xl">
    <section class="w-full max-w-[30rem] rounded-xl border border-surface-variant bg-surface-container-lowest p-xl shadow-sm">
        <a href="/login" class="mb-xl inline-flex items-center gap-3 text-title-md text-primary">
            <img src="/images/crest.svg" alt="" class="size-10" />
            SCMS Portal
        </a>
        <h1 tabindex="-1" class="text-headline-lg-mobile text-on-surface focus:outline-none">Create your account</h1>
        <p class="mt-2 text-body-md text-on-surface-variant">Register as a student to access the complaint portal.</p>

        @if (Error)
        {
            <p class="mt-lg rounded-lg bg-error-container px-md py-sm text-body-md text-on-error-container" role="alert">
                Registration failed. Check the fields, password requirements, and whether the email is already in use.
            </p>
        }

        <form action="/auth/register" method="post" class="mt-xl flex flex-col gap-lg">
            <div class="flex flex-col gap-2">
                <label class="field-label" for="full-name">Full name</label>
                <input class="field-input" id="full-name" name="FullName" type="text" autocomplete="name" minlength="3" maxlength="100" required />
            </div>
            <div class="flex flex-col gap-2">
                <label class="field-label" for="email">Email</label>
                <input class="field-input" id="email" name="Email" type="email" autocomplete="email" required />
            </div>
            <div class="flex flex-col gap-2">
                <label class="field-label" for="password">Password</label>
                <input class="field-input" id="password" name="Password" type="password" autocomplete="new-password" minlength="6" required aria-describedby="password-hint" />
                <p id="password-hint" class="text-caption text-on-surface-variant">At least 6 characters, including uppercase, lowercase, a number, and a symbol.</p>
            </div>
            <button class="btn btn-primary mt-sm w-full" type="submit">Create account</button>
        </form>

        <p class="mt-lg text-center text-body-md text-on-surface-variant">
            Already have an account? <a href="/login" class="font-semibold text-primary hover:underline">Sign in</a>
        </p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorQuery { get; set; }

    private bool Error => ErrorQuery == "1";
}