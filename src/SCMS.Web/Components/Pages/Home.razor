@page "/"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationState

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        var destination = user.Identity?.IsAuthenticated != true
            ? "/login"
            : user.IsInRole("Admin") ? AppRoutes.AdminDashboard : AppRoutes.Dashboard;
        Navigation.NavigateTo(destination, replace: true);
    }
}
