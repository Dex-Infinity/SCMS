@* Fixed on desktop (md+); an off-canvas drawer on smaller screens. *@

@if (IsOpen)
{
    <div class="fixed inset-0 z-30 bg-black/40 md:hidden" aria-hidden="true" @onclick="CloseAsync"></div>
}

<nav id="primary-navigation"
     aria-label="Primary"
     class="@NavClass">
    <a href="/" class="flex items-center gap-md border-b border-surface-variant px-md pb-lg focus-visible:outline-2 focus-visible:outline-primary-container">
        <img src="@Assets["images/crest.svg"]" alt="" class="size-10 shrink-0 object-contain" />
        <div>
            <div class="text-lg leading-tight text-primary">SCMS Portal</div>
            <p class="text-caption text-secondary">Institutional Authority</p>
        </div>
    </a>

    <ul class="mt-lg flex flex-1 flex-col gap-base">
        @foreach (var item in VisibleItems)
        {
            <li>
                <NavLink href="@item.Href" Match="NavLinkMatch.Prefix" class="nav-link" ActiveClass="active" @onclick="CloseAsync">
                    <Icon Name="@item.Icon" />
                    <span>@item.Label</span>
                </NavLink>
            </li>
        }
    </ul>

    <div class="mt-auto flex flex-col gap-sm">
        @if (IsAuthenticated)
        {
            <a href="@AppRoutes.Profile" class="nav-link" @onclick="CloseAsync"><Icon Name="person" /><span>Profile</span></a>
            <a href="@AppRoutes.Settings" class="nav-link" @onclick="CloseAsync"><Icon Name="settings" /><span>Settings</span></a>
            <form action="/auth/logout" method="post">
                <button type="submit" class="nav-link w-full text-left">
                    <Icon Name="logout" />
                    <span>Logout</span>
                </button>
            </form>
        }
        else
        {
            <a href="/login" class="nav-link"><Icon Name="login" /><span>Sign in</span></a>
        }
    </div>
</nav>

@code {
    private sealed record NavItem(string Label, string Icon, string Href);

    private static readonly NavItem[] Items =
    [
        new("Dashboard", "dashboard", AppRoutes.Dashboard),
        new("My Complaints", "assignment_late", AppRoutes.Complaints),
        new("Submit New", "add_circle", AppRoutes.SubmitComplaint),
        new("History", "history", AppRoutes.History)
    ];

    private IEnumerable<NavItem> VisibleItems => !IsAuthenticated
        ? []
        : IsAdmin
            ? [new("Admin Dashboard", "dashboard", AppRoutes.AdminDashboard), new("Notifications", "notifications", AppRoutes.Notifications), new("Management Analytics", "analytics", "/management/analytics")]
            : [.. Items, new("Notifications", "notifications", AppRoutes.Notifications)];

    /// <summary>Only affects screens below "md", where the sidebar is a drawer.</summary>
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public bool IsAuthenticated { get; set; }

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private Task CloseAsync() => OnClose.InvokeAsync();

    // Closed on phones: slide off-screen and hide from keyboard/AT. Always visible from "md" up.
    private string NavClass =>
        "fixed inset-y-0 left-0 z-40 flex w-64 flex-col gap-base bg-surface px-md py-xl shadow-md transition-[transform,visibility] duration-200 motion-reduce:transition-none md:visible md:z-20 md:translate-x-0 "
        + (IsOpen ? "visible translate-x-0" : "invisible -translate-x-full");
}
