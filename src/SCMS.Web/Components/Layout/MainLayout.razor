@inherits LayoutComponentBase
@inject ICurrentUserService Users
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ScmsApiClient Api
@inject ILogger<MainLayout> Logger

<div class="min-h-screen bg-surface text-on-surface">
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-md focus:left-md focus:z-50 focus:rounded-lg focus:bg-primary-container focus:px-md focus:py-sm focus:text-on-primary">
        Skip to main content
    </a>

    <Sidebar IsOpen="_sidebarOpen" IsAuthenticated="_isAuthenticated" IsAdmin="_isAdmin" OnClose="CloseSidebar" />

    <div class="flex min-h-screen flex-col md:pl-64">
        <TopNavbar UserName="@(_user?.DisplayName ?? string.Empty)"
                   IsAuthenticated="_isAuthenticated"
                   UnreadNotifications="@_unreadNotifications"
                   IsLoadingUser="_userLoading"
                   IsLoadingNotifications="_unreadCountLoading"
                   OnMenuClick="OpenSidebar" />

        <main id="main-content" class="flex-1 p-margin-mobile md:p-xl">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui"
     class="fixed inset-x-0 bottom-0 z-50 hidden items-center justify-between gap-md bg-error-container px-lg py-sm text-label-sm text-on-error-container shadow-md"
     role="alert">
    <span>An unexpected error occurred.</span>
    <span class="flex items-center gap-md">
        <a href="." class="font-semibold underline">Reload</a>
        <button type="button" class="dismiss" aria-label="Dismiss">&#x2715;</button>
    </span>
</div>

@code {
    private int _unreadNotifications;
    private CurrentUser? _user;
    private bool _isAuthenticated;
    private bool _isAdmin;
    private bool _sidebarOpen;
    private bool _userLoading;
    private bool _unreadCountLoading;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        _isAuthenticated = principal.Identity?.IsAuthenticated == true;
        _isAdmin = principal.IsInRole("Admin");

        if (!_isAuthenticated)
        {
            return;
        }

        _userLoading = true;
        try
        {
            _user = await Users.GetAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?error=session", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not fetch current user profile from service, falling back to identity");
            _user = new CurrentUser(principal.Identity?.Name ?? "Account");
        }
        finally
        {
            _userLoading = false;
        }

        _unreadCountLoading = true;
        try
        {
            _unreadNotifications = await Api.GetUnreadCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load the unread notification count");
        }
        finally
        {
            _unreadCountLoading = false;
        }
    }

    private void OpenSidebar() => _sidebarOpen = true;
    private void CloseSidebar() => _sidebarOpen = false;
}
