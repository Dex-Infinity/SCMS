@using System.Globalization
@using System.Text

@* Smoothed line chart with a soft fill, scaled to the min/max of the data. Labels run along the bottom. *@
<div class="flex h-full flex-col">
    <div class="min-h-[150px] flex-1 overflow-hidden rounded-lg bg-surface-container-low">
        <svg class="block size-full" viewBox="0 0 100 50" preserveAspectRatio="none" role="img" aria-label="@AriaLabel">
            @if (_line.Length > 0)
            {
                <path d="@_area" class="fill-primary-fixed opacity-30" stroke="none" />
                <path d="@_line" class="stroke-primary" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            }
        </svg>
    </div>

    <div class="mt-sm flex justify-between text-caption text-on-surface-variant" aria-hidden="true">
        @foreach (var point in Points)
        {
            <span>@point.Label</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ChartPoint> Points { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = "Trend";

    private string _line = string.Empty;
    private string _area = string.Empty;

    private string AriaLabel =>
        Title + ": " + string.Join(", ", Points.Select(p => p.Label + " " + p.Value.ToString("0.#", CultureInfo.InvariantCulture)));

    protected override void OnParametersSet()
    {
        _line = string.Empty;
        _area = string.Empty;

        if (Points.Count < 2)
        {
            return;
        }

        var min = Points.Min(p => p.Value);
        var max = Points.Max(p => p.Value);
        var range = max - min;

        // Map values into a 100 x 50 box, keeping a margin at the top and bottom.
        var xy = Points
            .Select((p, i) => (X: i * 100.0 / (Points.Count - 1), Y: range <= 0 ? 25.0 : 45.0 - (p.Value - min) / range * 35.0))
            .ToArray();

        // Catmull-Rom spline converted to cubic Bezier segments for a smooth curve through every point.
        var path = new StringBuilder();
        path.Append(CultureInfo.InvariantCulture, $"M{xy[0].X:0.##},{xy[0].Y:0.##}");

        for (var i = 0; i < xy.Length - 1; i++)
        {
            var p0 = xy[Math.Max(i - 1, 0)];
            var p1 = xy[i];
            var p2 = xy[i + 1];
            var p3 = xy[Math.Min(i + 2, xy.Length - 1)];

            var c1x = p1.X + (p2.X - p0.X) / 6;
            var c1y = p1.Y + (p2.Y - p0.Y) / 6;
            var c2x = p2.X - (p3.X - p1.X) / 6;
            var c2y = p2.Y - (p3.Y - p1.Y) / 6;

            path.Append(CultureInfo.InvariantCulture, $" C{c1x:0.##},{c1y:0.##} {c2x:0.##},{c2y:0.##} {p2.X:0.##},{p2.Y:0.##}");
        }

        _line = path.ToString();
        _area = _line + " L100,50 L0,50 Z";
    }
}
