<EditForm Model="Model" OnValidSubmit="SubmitAsync" class="grid grid-cols-1 items-end gap-md sm:grid-cols-[1fr_1fr_auto_auto]">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-caption text-error sm:col-span-4" />
    <div class="flex flex-col gap-2">
        <label class="field-label" for="@($"department-{ComplaintId}")">Department ID</label>
        <InputNumber id="@($"department-{ComplaintId}")" class="field-input" @bind-Value="Model.DepartmentId" min="1" required />
        <ValidationMessage For="() => Model.DepartmentId" />
    </div>
    <div class="flex flex-col gap-2">
        <label class="field-label" for="@($"staff-{ComplaintId}")">Assigned staff ID <span class="text-outline">(optional)</span></label>
        <InputNumber id="@($"staff-{ComplaintId}")" class="field-input" @bind-Value="Model.AssignedToId" min="1" />
    </div>
    <button type="submit" class="btn btn-primary" disabled="@Busy">
        @if (Busy) { <Icon Name="progress_activity" Class="animate-spin motion-reduce:animate-none" /><span>Saving</span> }
        else { <Icon Name="save" /><span>Save assignment</span> }
    </button>
    <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
</EditForm>

@code {
    [Parameter, EditorRequired] public int ComplaintId { get; set; }
    [Parameter, EditorRequired] public ComplaintAssignment Model { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    [Parameter, EditorRequired] public EventCallback<ComplaintAssignment> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task SubmitAsync() => OnSave.InvokeAsync(Model);
}